  "usage_examples": {
    "basic_task_card": {
      "description": "Add button to task card component",
      "code": "import { CompleteWithClaudeButton } from '@/components/CompleteWithClaudeButton';\nimport { useAuth } from '@/contexts/AuthContext';\n\nexport function TaskCard({ task, onTaskUpdate }) {\n  const { organization } = useAuth();\n\n  return (\n    <div className=\"task-card\">\n      <h3>{task.title}</h3>\n      <p>{task.description}</p>\n      \n      <CompleteWithClaudeButton\n        task={task}\n        tenantId={organization.id}\n        onComplete={(result) => {\n          onTaskUpdate({ ...task, status: 'completed' });\n        }}\n      />\n    </div>\n  );\n}"
    },
    "custom_implementation": {
      "description": "Use hook for custom UI",
      "code": "import { useCompleteTask } from '@/hooks/useCompleteTask';\n\nexport function TaskActions({ task, tenantId, onTaskUpdate }) {\n  const { completeTask, isLoading, lastError } = useCompleteTask();\n\n  const handleComplete = async () => {\n    const result = await completeTask(task, tenantId, {\n      customPrompt: 'Include deliverables summary',\n      showToast: true,\n    });\n\n    if (result.success) {\n      onTaskUpdate({ ...task, status: 'completed' });\n    }\n  };\n\n  return (\n    <button onClick={handleComplete} disabled={isLoading}>\n      {isLoading ? 'Completing...' : 'Complete'}\n    </button>\n  );\n}"
    },
    "availability_check": {
      "description": "Check if AI features are available",
      "code": "import { useAICompletionAvailable } from '@/hooks/useCompleteTask';\n\nexport function TaskMenu({ task }) {\n  const { isAvailable, isChecking } = useAICompletionAvailable();\n\n  if (isChecking) return <Spinner />;\n  if (!isAvailable) return null;\n\n  return <CompleteWithClaudeButton task={task} tenantId={organization.id} />;\n}"
    }
  },
  "api_reference": {
    "endpoint": "POST /api/tasks/complete-with-claude",
    "authentication": "Bearer token (Authorization header)",
    "request_body": {
      "tenantId": "string (required) - Organization UUID",
      "taskId": "string (required) - Task UUID",
      "taskTitle": "string (required) - Task title",
      "taskDescription": "string (required) - Task description",
      "customPrompt": "string (optional) - Additional context for Claude",
      "targetStatus": "string (required) - Must be 'completed'"
    },
    "response_success": {
      "status": 200,
      "body": {
        "success": true,
        "taskId": "task-uuid",
        "completionNotes": "Generated notes by Claude...",
        "model": "claude-3-5-sonnet-20241022",
        "tokensUsed": {
          "input": 150,
          "output": 85
        }
      }
    },
    "response_error": {
      "status": "varies (400-503)",
      "body": {
        "success": false,
        "taskId": "task-uuid",
        "error": "error_code",
        "message": "Human-readable error message"
      }
    },
    "error_codes": [
      {
        "code": "ai_non_configurata",
        "status": 503,
        "meaning": "ANTHROPIC_API_KEY not configured",
        "user_action": "Contact administrator"
      },
      {
        "code": "ai_chiave_non_valida",
        "status": 503,
        "meaning": "Invalid or expired API key",
        "user_action": "Contact administrator"
      },
      {
        "code": "ai_workspace_mancante",
        "status": 503,
        "meaning": "Workspace ID required but not configured",
        "user_action": "Contact administrator"
      },
      {
        "code": "limite_richieste_superato",
        "status": 429,
        "meaning": "Rate limit exceeded (30/hour per user)",
        "user_action": "Retry after 1 hour"
      },
      {
        "code": "prompt_troppo_lungo",
        "status": 413,
        "meaning": "Request exceeds 10,000 character limit",
        "user_action": "Reduce prompt length"
      },
      {
        "code": "tenant_mancante",
        "status": 400,
        "meaning": "Organization ID not provided",
        "user_action": "Refresh page or contact support"
      },
      {
        "code": "task_mancante",
        "status": 400,
        "meaning": "Task ID not provided",
        "user_action": "Refresh page or contact support"
      },
      {
        "code": "risposta_rifiutata",
        "status": 422,
        "meaning": "Claude refused the request (policy violation)",
        "user_action": "Try with different task or prompt"
      },
      {
        "code": "risposta_vuota",
        "status": 502,
        "meaning": "Claude generated no completion notes",
        "user_action": "Retry or use custom prompt"
      }
    ]
  },
